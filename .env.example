# Required for the contact/booking/testimonial forms to send email.
# Uses the mailbox hosted on your domain (LWS) via SMTP.
#
# Create the mailbox (e.g. noreply@tresorossohou.site) in LWS Panel →
# E-mails if it doesn't exist yet, then fill in its outgoing server
# settings below (LWS Panel → "Paramètres de configuration mail").
SMTP_HOST=mail.tresorossohou.site
SMTP_PORT=465
SMTP_USER=noreply@tresorossohou.site
SMTP_PASSWORD=
