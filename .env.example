# Required for the contact/booking/testimonial forms to send email.
# Uses the mailbox hosted on your domain (LWS) via SMTP.
#
# Create the mailbox (e.g. noreply@tresorossohou.site) in LWS Panel →
# E-mails if it doesn't exist yet, then fill in its outgoing server
# settings below (LWS Panel → "Paramètres de configuration mail").
SMTP_HOST=mail.tresorossohou.site
SMTP_PORT=465
SMTP_USER=noreply@tresorossohou.site
SMTP_PASSWORD=

# Required for the admin panel (modifications.tresorossohou.site).
# ADMIN_PASSWORD: the password you type to log in.
# ADMIN_SESSION_SECRET: any long random string (used to sign the login
#   session cookie) — generate one with `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Required for the admin panel to save changes (projects, testimonials).
# Changes are committed straight to this GitHub repo, which triggers
# Vercel's normal auto-deploy — no separate database needed.
# GITHUB_TOKEN: a fine-grained Personal Access Token scoped to just
#   this repo, with "Contents" read & write permission only.
#   Create one at https://github.com/settings/personal-access-tokens/new
# GITHUB_REPO: "owner/repo", e.g. daniquetresor/Mon-Porfolio
GITHUB_TOKEN=
GITHUB_REPO=daniquetresor/Mon-Porfolio
GITHUB_BRANCH=main
